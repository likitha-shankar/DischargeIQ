# ── LLM (all agents use the same LLM_PROVIDER via get_llm_client / _get_client) ──
# gemini | anthropic | openrouter | openai | ollama
LLM_PROVIDER=gemini

# Default when LLM_MODEL is unset:
#   gemini     → gemini-2.5-flash-lite  (fast, cheap; override with gemini-2.5-flash for higher quality)
#   anthropic  → claude-haiku-4-5-20251001
#   openrouter → openai/gpt-4o-mini
#   openai     → gpt-4o-mini
#   ollama     → llama3.2
# LLM_MODEL=

# API keys — set the key for your LLM_PROVIDER.
# GOOGLE_API_KEY is required when LLM_PROVIDER=gemini (the default).
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Ollama base URL — only if LLM_PROVIDER=ollama and not on localhost
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Neon PostgreSQL connection string (optional for core /analyze; required for history writes)
DATABASE_URL=

# ── Security ──────────────────────────────────────────────────────────────────
# Optional API key for POST /analyze and POST /chat.
# When set, requests must include: Authorization: Bearer <key>
# When unset, endpoints are open (dev mode). ALWAYS set this in production.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# DISCHARGEIQ_API_KEY=

# Production Streamlit origin for CORS.
# When set, only this origin (+ localhost) is allowed to call /chat from the browser.
# Example: STREAMLIT_ORIGIN=https://dischargeiq-1015692703359.us-central1.run.app
# STREAMLIT_ORIGIN=

