# Cloud Build upload excludes for `gcloud run deploy --source .`
# The backend image (Dockerfile) only needs the Python app; keep the mobile
# app, archives, and build artifacts out of the upload
# so builds are fast and cheap.

.git/
.gitignore

# Mobile app (not part of the backend image) - ~1.8GB of Flutter build output
dischargeiq_mobile/

# Frontend deps (reinstalled, never shipped in the backend image)

# Local-only archive and distribution artifacts
_archive/
dist/

# Python caches and local venv
.venv/
**/__pycache__/
*.pyc

# Local env and logs (secrets come from Cloud Run env vars, not the image)
.env
logs/
evaluation/corpus_outputs/

# iOS/desktop bits not used by the backend
ios/

# Device backups pulled off the phone by scripts/backup_ios_data.sh. These
# hold REAL analysed discharge documents and PDFs. They are gitignored for
# that reason, and they must not ride along in a Cloud Build upload either.
device-backups/

# The de-identified evaluation corpus and the degraded fax stratum built from
# it. Dockerfile does `COPY . .`, so without these lines 106 real (if
# de-identified) clinical transcriptions get uploaded to Cloud Build and baked
# into the running image. Nothing at runtime reads them - they are test and
# evaluation inputs, referenced only by tests, comments and one instruction
# string in the clinician dashboard.
#
# Same reasoning as device-backups/ above: clinical text does not travel
# further than it has to. The corpus is gitignored for this reason and this
# file simply had not caught up.
test-data/mtsamples/
test-data/fax/
