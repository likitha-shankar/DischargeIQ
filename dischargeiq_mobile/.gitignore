# Flutter / Dart
.dart_tool/
build/
.flutter-plugins
.flutter-plugins-dependencies
.packages
*.g.dart

# Keep pubspec.lock committed for reproducible app builds unless the team decides otherwise.

# iOS
ios/Pods/
ios/.symlinks/

# Android
android/.gradle/
android/local.properties

# IDE (local)
.idea/
*.iml

# Flutter per-machine generated plugin symlinks (regenerated on build)
**/flutter/ephemeral/
**/.plugin_symlinks/

# macOS desktop target - out of scope (app is iOS + Android); Flutter-generated
# runner scaffolding is build noise. Already-tracked ephemeral files are kept.
macos/Podfile
macos/Podfile.lock
macos/.gitignore
macos/Flutter/Flutter-Debug.xcconfig
macos/Flutter/Flutter-Release.xcconfig
macos/Runner.xcodeproj/
macos/Runner.xcworkspace/
macos/Runner/
macos/RunnerTests/
